(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call (load "unit_test_howso.amlg") (assoc name "ut_h_influential_cases_feature_weights.amlg"))

	;cases are labeled by their "id" feature so they're easy to identify in the influential cases output
	(declare (assoc
		data
			(list
				(list "A" 0 10 0)
				(list "B" 0.1 0 1)
				(list "C" 5 0.1 2)
				(list "D" 5 10 3)
			)
		features (list "id" "x" "z" "y")
	))

	(call_entity "howso" "set_feature_attributes" (assoc
		feature_attributes
			(assoc
				"id" (assoc "type" "nominal")
				"x" (assoc "type" "continuous")
				"z" (assoc "type" "continuous")
				"y" (assoc "type" "continuous")
			)
	))

	(call_entity "howso" "train" (assoc
		cases data
		features features
		session "session1"
	))

	(call_entity "howso" "set_params" (assoc
		default_data_parameters_map (assoc "k" 2 "p" 2 "dt" -1)
	))

	(declare (assoc
		;helper to get the sorted list of ids of the influential cases
		get_inf_ids
			(lambda
				(sort (map (lambda (get (current_value) "id")) (get result "influential_cases")))
			)
		result .null
		default_action_values .null
	))

	(print "Default influential cases (equal weights):\n")
	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				context_features (list "x" "z")
				context_values (list 0.05 0.05)
				action_features (list "y")
				extra_features (list "id")
				details (assoc "influential_cases" .true)
			))
	))
	(call keep_result_payload)
	(assign (assoc default_action_values (get result "action_values") ))
	(call assert_same (assoc exp (list "B" "C") obs (call get_inf_ids)))

	(print "Influential cases with z weighted to 0:\n")
	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				context_features (list "x" "z")
				context_values (list 0.05 0.05)
				action_features (list "y")
				extra_features (list "id")
				details (assoc "influential_cases" .true)
				feature_weights (assoc "z" 0)
			))
	))
	(call keep_result_payload)
	(call assert_same (assoc exp (list "A" "B") obs (call get_inf_ids)))
	(print "equidistant cases have equal influence weights: ")
	(call assert_approximate (assoc exp 0.5 obs (get result ["influential_cases" 0 ".influence_weight"]) thresh 0.001))
	(call assert_approximate (assoc exp 0.5 obs (get result ["influential_cases" 1 ".influence_weight"]) thresh 0.001))
	(print "prediction is unaffected by influential cases feature weights: ")
	(call assert_same (assoc exp default_action_values obs (get result "action_values")))

	(print "Raw weights are returned for user-weighted influential cases: ")
	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				context_features (list "x" "z")
				context_values (list 0.05 0.05)
				action_features (list "y")
				extra_features (list "id")
				details (assoc "influential_cases" .true "influential_cases_raw_weights" .true)
				feature_weights (assoc "z" 0)
			))
	))
	(call keep_result_payload)
	(call assert_same (assoc exp (list "A" "B") obs (call get_inf_ids)))
	(call assert_true (assoc obs (> (get result ["influential_cases" 0 ".raw_influence_weight"]) 0) ))

	(print "Unspecified features keep trainee weights: ")
	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				context_features (list "x" "z")
				context_values (list 0.05 0.05)
				action_features (list "y")
				extra_features (list "id")
				details (assoc "influential_cases" .true)
				feature_weights (assoc "x" 1)
			))
	))
	(call keep_result_payload)
	(call assert_same (assoc exp (list "B" "C") obs (call get_inf_ids)))

	(call exit_if_failures (assoc msg "single_react influential cases feature weights"))

	(print "Batch react with influential cases feature weights:\n")
	(assign (assoc
		result
			(call_entity "howso" "react" (assoc
				context_features (list "x" "z")
				context_values (list (list 0.05 0.05) (list 0.05 0.05))
				action_features (list "y")
				extra_features (list "id")
				details (assoc "influential_cases" .true)
				feature_weights (assoc "z" 0)
			))
	))
	(call keep_result_payload)
	(call assert_same (assoc
		exp (list (list "A" "B") (list "A" "B"))
		obs
			(map
				(lambda (sort (map (lambda (get (current_value) "id")) (current_value))))
				(get result "influential_cases")
			)
	))
	(call assert_same (assoc exp (list default_action_values default_action_values) obs (get result "action_values")))

	(print "Explaining provided action values with influential cases feature weights:\n")
	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				context_features (list "x" "z")
				context_values (list 0.05 0.05)
				action_features (list "y")
				extra_features (list "id")
				action_values (list 1)
				details (assoc "influential_cases" .true)
				feature_weights (assoc "z" 0)
			))
	))
	(call keep_result_payload)
	;z has no weight, so the cases nearest on x (A and B) are influential
	(call assert_same (assoc exp (list "A" "B") obs (call get_inf_ids)))

	(call exit_if_failures (assoc msg unit_test_name ))
)
