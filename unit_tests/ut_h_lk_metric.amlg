(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call init_unit_test {name "ut_h_lk_metric.amlg"})
	(assign_to_entities (load "../module/details_residuals.amlg"))

	;Normalize the observed result so the test harness cannot treat large finite values as infinity.
	(map
		(lambda
			(let {test (current_value 1)}
				(call assert_approximate {
					obs (/ (call !LK_metric_laplace {
						difference (get test 0) deviation (get test 1)
					}) (get test 2))
					exp (get test 3)
					percent 1e-10
				})
			)
		)
		;difference, deviation, normalization, expected ratio
		[[0 1 1 1.5] [1 1 1 1.7357588823428847]
		 [0 1e308 1e308 1.5] [1e308 1e308 1e308 1.7357588823428847]
		 [1e308 1e-308 1e308 1] [1e-308 1e-308 1e-308 1.7357588823428847]
		 [5e-324 5e-324 5e-324 2]]
	)
	(call exit_if_failures {msg "Laplace LK finite-input boundaries"})
)
