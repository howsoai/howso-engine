(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call (load "unit_test_howso.amlg") (assoc name "ut_h_anomaly.amlg"))

	(call_entity "howso" "create_trainee" (assoc trainee "model"))

	(declare (assoc
		model_data (load "unit_test_data/iris.csv")
	))
	(declare (assoc
		data (tail model_data)
		features (first model_data)
	))
	(declare (assoc action_features (list (last features))))

	(call_entity "howso" "set_feature_attributes" (assoc
		feature_attributes (assoc "target" (assoc "type" "nominal") )
	))

	(call_entity "howso" "train" (assoc
		cases data
		features features
		session "session1"
	))

	(call_entity "howso" "analyze" (assoc
		context_features (tail features)
		action_features action_features
	))

	(call_entity "howso" "react_into_features" (assoc
		distance_contribution .true
		similarity_conviction .true
		familiarity_conviction_addition .true
	))

	(declare (assoc
		cases
			(get
				(call_entity "howso" "get_cases" (assoc
					features (list ".session_training_index" ".similarity_conviction" ".familiarity_conviction_addition" ".distance_contribution")
				))
				(list 1 "payload" "cases")
			)
	))


	(print "All similarity convictions are computed as non-null: ")
	(call assert_true (assoc
		obs
			(not (contains_value
				(map (lambda (get (current_value) 1)) cases)
				.null
			))
	))

	(print "All Familiarity convictions are computed as non-null: ")
	(call assert_true (assoc
		obs
			(not (contains_value
				(map (lambda (get (current_value) 2)) cases)
				.null
			))
	))

	(print "All Distance contributions are computed as non-null: ")
	(call assert_true (assoc
		obs
			(not (contains_value
				(map (lambda (get (current_value) 3)) cases)
				.null
			))
	))

	; (print
	; 	(sort
	; 		(lambda (<
	; 			(get (current_value) 2)
	; 			(get (current_value 1) 2)
	; 		))
	; 		cases
	; 	)
	; )

	(declare (assoc
		residual_contribution
			(get
				(call_entity "howso" "react" (assoc
					context_features (tail features)
					context_values [ [2.4 4.8 1.2 2]]
					details {"residual_contribution" .true}
				))
				(list 1 "payload" "residual_contribution" 0)
			)
	))

	(print "Computing residual contribution through react: ")
	(call assert_approximate (assoc
		obs residual_contribution
		exp 1.8
		thresh 0.1
	))

	(call_entity "howso" "react_into_features" (assoc
		residual_contribution .true
	))

	(declare (assoc
		ris_contributions
			(get
				(call_entity "howso" "get_cases" (assoc
					features [".residual_contribution"]
				))
				[1 "payload" "cases"]
			)
	))

	(print "Computing residual contribution through react_into_features: ")
	(call assert_true (assoc
		obs
			;just check that all of the contributions are computed to be non-null
			(!=
				.null
				(apply "+" (map
					(lambda (first (current_value)))
					ris_contributions
				))
			)
	))

	(print "Supervised AD flow tests:\n")
	(call_entity "howso" "add_feature" (assoc
		feature_name "is_anomaly"
		values (range (lambda (rand [.true .false])) 1 (size data) 1)
		case_indices (range (lambda ["session1" (current_index 1)]) 1 (size data) 1)
		feature_attributes
			{
				"type" "nominal"
				"data_type" "boolean"
			}
	))
	(call_entity "howso" "analyze")

	(declare (assoc
		new_case_reaction
			(get
				(call_entity "howso" "react" (assoc
						action_features ["is_anomaly"]
						context_features features
						context_values [ [2.4 4.8 1.2 2 0]]
						derived_context_features [".residual_contribution" ".distance_contribution" ".similarity_conviction"]
						return_context_values .true
						details
							{
								"categorical_action_probabilities" .true
								"influential_cases" .true
							}
				))
				[1 "payload"]
			)
	))
	(print "derived_context_feature AD metrics get computed (and returned) correctly for new cases: ")
	(call assert_true (assoc
		obs (not (contains_value (get new_case_reaction "context_values") .null))
	))
	(call assert_same (assoc
		obs (size (get new_case_reaction ["context_values" 0]))
		exp 8
	))

	(declare (assoc
		possibly_new_case_reaction
			(get
				(call_entity "howso" "react" (assoc
						action_features ["is_anomaly"]
						context_features features
						context_values [ [6.2 2.8 4.8 1.8 "2"] ] ;this is the third case in the dataset
						leave_case_out .true
						derived_context_features [".residual_contribution" ".distance_contribution" ".similarity_conviction"]
						return_context_values .true
						details
							{
								"categorical_action_probabilities" .true
							}
				))
				[1 "payload"]
			)
		existing_case_reaction
			(get
				(call_entity "howso" "react" (assoc
						action_features ["is_anomaly"]
						context_features (append features [".residual_contribution" ".distance_contribution" ".similarity_conviction"])
						preserve_feature_values (append features [".residual_contribution" ".distance_contribution" ".similarity_conviction"])
						case_indices [ ["session1" 2] ] ;this is the third case in the dataset
						leave_case_out .true
						return_context_values .true
						details
							{
								"categorical_action_probabilities" .true
							}
				))
				[1 "payload"]
			)
	))
	(print "Both possibly-new-case and existing-case flows return same values: ")
	(call assert_same (assoc
		exp (get existing_case_reaction "categorical_action_probabilities")
		obs (get possibly_new_case_reaction "categorical_action_probabilities")
	))
	(call assert_same (assoc
		exp
			(zip
				(get existing_case_reaction "context_features")
				(get existing_case_reaction ["context_values" 0])
			)
		obs
			(zip
				(get possibly_new_case_reaction "context_features")
				(get possibly_new_case_reaction ["context_values" 0])
			)
	))


	(call exit_if_failures (assoc msg unit_test_name))
)