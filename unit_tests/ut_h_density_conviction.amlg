(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call (load "unit_test_howso.amlg") (assoc name "ut_h_density_conviction.amlg" ))

	;Fixed neighborhoods isolate the outer weights from nearest-neighbor selection.
	(assign_to_entities (keep (load "../module/details_residuals.amlg") ["!CalculateLocalDensityConviction"]))
	(assign_to_entities (keep (load "../module/react_utilities.amlg") ["!ComputeCaseFeatureWeightedMADPair"]))
	(create_entities "density_low" {x 2})
	(create_entities "density_null" {x .null})
	(create_entities "density_high" {x 10})
	(create_entities "density_aux" {x 6})
	(let
		(assoc
			!nominalsMap {}
			!editDistanceFeatureTypesMap {}
			!cachedFeatureMinResidualMap {x 0.000001}
			case_value_map {x 0}
			action_features ["x"]
			continuous_with_nulls_map {x .true}
			local_cases_map {density_low 1 density_null 1 density_high 1}
			approximately_one 0.999999
		)
		(declare (assoc
			local_cases_maps (unzip
				{density_low {density_high 1} density_null {} density_high {density_aux 1}}
				(indices local_cases_map)
			)
		))
		(map
			(lambda (let
				(assoc
					weights (unzip (first (current_value 1)) (indices local_cases_map))
					expected_mads (last (current_value 1))
					local_avg_mad_map {}
					local_mad_map {}
				)
				(call !CalculateLocalDensityConviction)
				;Assert both MADs: their ratio alone hides the surviving-mass bug.
				(call assert_approximate (assoc
					obs (list (get local_avg_mad_map "x") (get local_mad_map "x"))
					exp expected_mads
					thresh 1e-10
				))
			))
			(list
				;40% null mass: surviving weights become [1/3, 2/3].
				(list {density_low 0.2 density_null 0.4 density_high 0.4} (list (/ 16 3) (/ 22 3)))
				;Zero null mass preserves the nonuniform weighted means.
				(list {density_low 0.25 density_null 0 density_high 0.75} [5 8])
				;Zero surviving weight uses uniform weights.
				(list {density_low 0 density_null 0 density_high 0} [6 6])
			)
		)
	)
	(destroy_entities "density_low" "density_null" "density_high" "density_aux")
	(remove_from_entities ["!CalculateLocalDensityConviction" "!ComputeCaseFeatureWeightedMADPair"])
	(call exit_if_failures (assoc msg "Conditional continuous local MADs."))

	(declare (assoc
		features ["x" "y" "color" ]
		result .null
		data
			[
				;group 1
				[ 100 	100 	"blue" ] ; 0
				[ 101 	100 	"blue" ]
				[ 100 	110 	"blue" ]
				[ 101 	110 	"blue" ]
				[ 102 	100 	"blue" ]
				[ 102 	110 	"blue" ] ; 5
				;group 2
				[ 100 	300 	"blue" ]
				[ 101 	300 	"blue" ]
				[ 100 	310 	"blue" ]
				[ 101 	310 	"blue" ]
				[ 102 	300 	"blue" ] ; 10
				[ 102 	310 	"blue" ]
				;case between group1 and 2
				[ 100 	200 	"blue" ] ; 12 - bimodal on 'y'
				;case outside group 1
				[ 100 	80 		"blue" ] ; 13
				;group 3
				[ 600 	600 	"orange" ]
				[ 601 	601 	"orange" ] ; 15 inlier
				[ 601 	601 	"orange" ]
				[ 601 	601 	"orange" ]
				[ 601 	601 	"orange" ]
				[ 602 	600 	"orange" ]

				;group 3 with continous nulls
				[ 600 	.null 	"green" ] ; 20
				[ 300 	400 	"green" ]
				[ 400 	.null	"green" ] ; null case
				[ 301 	400 	"green" ]
				[ 600 	.null 	"green" ]
				[ 500 	400 	"green" ] ; 25
				[ 501 	400 	"green" ]


				[ 11500 	100 	"yellow" ]
				[ 11501 	200 	"yellow" ]
				[ 11502 	300 	"yellow" ]
				[ 11503 	400 	"yellow" ] ;30
				[ 11504 	500 	"yellow" ]
				[ 11505 	500 	"yellow" ]
			]
	))


	(call_entity "howso" "set_feature_attributes" (assoc
		feature_attributes
			(assoc
				"x" (assoc "type" "continuous")
				"y" (assoc "type" "continuous")
				"color" (assoc "type" "nominal" "data_type" "string")
			)
	))


	(call_entity "howso" "train" (assoc
		cases data
		features features
		session "session1"
	))
	(call_entity "howso" "analyze")

	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 12)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))

	(call keep_result_payload)
	(print "Density conviction is extremely low for bi-modal neighbors: " (get result ["feature_density_convictions" "y"]) " " )
	(call assert_true (assoc
		obs (< (get result ["feature_density_convictions" "y"]) 0.1)
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 0)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)

	(print "Density conviction is max for all nominal match: ")
	(call assert_same (assoc
		exp .infinity
		obs (get result ["feature_density_convictions" "color"])
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 13)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction is very low for case outside group: " (get result ["feature_density_convictions" "y"]) " ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "y"])
		exp 0.2
		thresh 0.1
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 19)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction is low for case at edge of group: " (get result ["feature_density_convictions" "y"]) " ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "y"])
		exp 0.5
		thresh 0.1
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 7)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction is normal for case inside group: " (get result ["feature_density_convictions" "y"]) " ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "y"])
		exp 1.0
		thresh 0.2
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 15)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction is high for inlier case: " (get result ["feature_density_convictions" "y"]) " ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "y"])
		exp 1.6
		thresh 0.2
	))

	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session1" 22)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true influential_cases .true)
			))
	))
	(call keep_result_payload)

	(print "Density conviction for null is high, nulls are > 60% of influence: " (get result ["feature_density_convictions" "y"]) " ")
	(call assert_true (assoc
		obs (> (get result ["feature_density_convictions" "y"]) 1.58)
	))

	(call exit_if_failures (assoc msg "Continuous density convictions."))


	(call_entity "howso" "train" (assoc
		cases
			[
				[ 5000 	2000 	"yellow" ] ;0
				[ 5002 	2000 	"yellow" ]
				[ 5024 	2000 	"yellow" ] ;2

				[ 5050 	2019 	"tan"    ]
				[ 5050 	2019 	"tan" 	 ]
				[ 5052 	2019 	"tan" 	 ]

				[ 5082 	2019	"yellow" ] ;6

			]
		features features
		session "session2"
	))

	(call_entity "howso" "analyze")

	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session2" 0)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction for nominal is 1 because it's a 'yellow' among 99%+ 'yellow's: ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "color"])
		exp 1
		thresh 0.001
	))

	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session2" 2)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true)
			))
	))
	(call keep_result_payload)
	(print "Density conviction is high b/c mostly near 'yellow's with a little 'tan': " (get result ["feature_density_convictions" "color"]) " ")
	(call assert_approximate (assoc
		obs (get result ["feature_density_convictions" "color"])
		exp 1.5
		thresh 0.5
	))


	(assign (assoc
		result
			(call_entity "howso" "single_react" (assoc
				case_indices (list "session2" 6)
				preserve_feature_values features
				leave_case_out .true
				details (assoc feature_density_convictions .true )
			))
	))
	(call keep_result_payload)
	(print "Density conviction is low b/c more 'tan' are closer than other 'yellow': " (get result ["feature_density_convictions" "color"]) " ")
	(call assert_true (assoc
		obs (< (get result ["feature_density_convictions" "color"]) 1.2)
	))

	(call exit_if_failures (assoc msg "Nominal density convictions."))

	(call exit_if_failures (assoc msg unit_test_name))
)
