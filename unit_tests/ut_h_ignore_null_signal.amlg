(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call (load "unit_test_howso.amlg") (assoc name "ut_h_ignore_null_signal.amlg" retries 1))

	(declare (assoc
		features ["A" "B" "C"]
		;B and C are null whenever A > 60, so their nulls are predictable from A
		data
			(map
				(lambda [
					(current_value 1)
					(if (> (current_value 1) 60) .null (* 2 (current_value 1)))
					(if (> (current_value 1) 60) .null (concat "c" (mod (current_value 1) 3)))
				])
				(range 1 120)
			)
	))

	(call_entity "howso" "set_feature_attributes" (assoc
		feature_attributes {"A" {"type" "continuous"} "B" {"type" "continuous" "ignore_null_signal" .true} "C" {"type" "nominal" "ignore_null_signal" .true}}
	))

	(call_entity "howso" "train" (assoc
		features features
		cases data
	))

	(call_entity "howso" "analyze" (assoc k_values [5]))

	(declare (assoc
		deviations_map
			(get
				(call_entity "howso" "get_params")
				[1 "payload" "data_parameters_map" "targetless" "A.B.C." ".none" "featureDeviations"]
			)
	))

	;deviations for features with nulls end with [known-null deviation, null-null deviation]
	(print "Continuous null-null deviation is the same as known-null deviation when ignore_null_signal is true: ")
	(call assert_same (assoc
		obs (last (get deviations_map "B"))
		exp (get deviations_map ["B" 1])
	))

	(print "Nominal null-null deviation is the same as known-null deviation when ignore_null_signal is true: ")
	(call assert_same (assoc
		obs (last (get deviations_map "C"))
		exp (get deviations_map ["C" 1])
	))

	(call exit_if_failures (assoc msg "Ignore null signal." ))
)
