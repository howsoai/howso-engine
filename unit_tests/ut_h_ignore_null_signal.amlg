(seq
	(assign_to_entities (load "unit_test.amlg"))
	(call (load "unit_test_howso.amlg") (assoc name "ut_h_ignore_null_signal.amlg" retries 1))

	(declare (assoc
		features ["A" "B" "C"]
		;C is null whenever A > 60, so nulls in C are predictable from A
		data
			(map
				(lambda [
					(current_value 1)
					(* 2 (current_value 1))
					(if (> (current_value 1) 60) .null (concat "c" (mod (current_value 1) 3)))
				])
				(range 1 120)
			)
	))

	(call_entity "howso" "set_feature_attributes" (assoc
		feature_attributes {"A" {"type" "continuous"} "B" {"type" "continuous"} "C" {"type" "nominal" "ignore_null_signal" .true}}
	))

	(call_entity "howso" "train" (assoc
		features features
		cases data
		session "s1"
	))

	(call_entity "howso" "analyze" (assoc k_values [5]))

	(declare (assoc
		deviations
			(get
				(call_entity "howso" "get_params")
				[1 "payload" "data_parameters_map" "targetless" "A.B.C." ".none" "featureDeviations" "C"]
			)
	))

	(print "Null-null deviation is not shrunk when ignore_null_signal is true: ")
	(call assert_same (assoc
		obs (last deviations)
		exp (get deviations (- (size deviations) 2))
	))

	(call exit_if_failures (assoc msg "Ignore null signal." ))

	;a null context value for C should be held out of the query, making it equivalent to not specifying C at all
	(declare (assoc
		result_with_null_context
			(get
				(call_entity "howso" "single_react" (assoc
					context_features ["A" "C"]
					context_values [58.5 .null]
					action_features ["B"]
					details {"influential_cases" .true}
				))
				[1 "payload"]
			)
		result_without_context
			(get
				(call_entity "howso" "single_react" (assoc
					context_features ["A"]
					context_values [58.5]
					action_features ["B"]
					details {"influential_cases" .true}
				))
				[1 "payload"]
			)
	))

	(print "Null context value is held out of the query for action value: ")
	(call assert_same (assoc
		obs (get result_with_null_context "action_values")
		exp (get result_without_context "action_values")
	))
	(print "Null context value is held out of the query for influential cases: ")
	(call assert_same (assoc
		obs (get result_with_null_context "influential_cases")
		exp (get result_without_context "influential_cases")
	))

	;a null value for C preserved from an existing case should also be held out of the query
	;case at index 99 has A=100 and C=null
	(declare (assoc
		result_with_null_preserved
			(get
				(call_entity "howso" "single_react" (assoc
					action_features ["B"]
					case_indices ["s1" 99]
					preserve_feature_values ["A" "C"]
					leave_case_out .true
					details {"influential_cases" .true}
				))
				[1 "payload"]
			)
		result_without_preserved
			(get
				(call_entity "howso" "single_react" (assoc
					action_features ["B"]
					case_indices ["s1" 99]
					preserve_feature_values ["A"]
					leave_case_out .true
					details {"influential_cases" .true}
				))
				[1 "payload"]
			)
	))

	(print "Preserved null value is held out of the query for action value: ")
	(call assert_same (assoc
		obs (get result_with_null_preserved "action_values")
		exp (get result_without_preserved "action_values")
	))
	(print "Preserved null value is held out of the query for influential cases: ")
	(call assert_same (assoc
		obs (get result_with_null_preserved "influential_cases")
		exp (get result_without_preserved "influential_cases")
	))

	(call exit_if_failures (assoc msg "Null contexts held out for ignore_null_signal features." ))
)
