;Contains methods for computing and outputting residuals.
{
	;helper method to compute weighted midranks for a list of values, matching wCorr's weighted-rank definition for Spearman:
	;rank(v) = (total weight of all values strictly less than v) + (total weight tied at v) / 2
	;parameters:
	; values: list of values to rank
	; weights: list of corresponding weights, parallel to values
	;returns an assoc mapping each distinct value to its weighted rank
	!GetWeightedRankMap
	(declare
		(assoc
			values (list)
			weights (list)

			;not parameters
			cumulative_weight 0
			rank_map (assoc)
		)

		;aggregate total weight behind each distinct value so ties share a rank
		(declare (assoc
			value_weight_map
				(zip
					(lambda (+ (current_value) (current_value 1)))
					values
					weights
				)
		))

		;walk distinct values ascending, assigning weight-of-smaller-values + half its own tied weight
		(map
			(lambda (let
				(assoc value_weight (get value_weight_map (current_value 1)) )
				(seq
					(accum (assoc rank_map (associate (current_value 2) (+ cumulative_weight (/ value_weight 2))) ))
					(accum (assoc cumulative_weight value_weight))
				)
			))
			(sort (indices value_weight_map))
		)

		rank_map
	)

	;computes weighted Spearman's rho the way wCorr does: weighted midranks, then a weighted Pearson correlation over those ranks
	;parameters:
	; actual_values: list of actual values
	; predicted_values: list of predicted values, parallel to actual_values
	; weights: list of corresponding weights, parallel to actual_values/predicted_values
	!ComputeWeightedSpearmanCoefficient
	(declare
		(assoc
			actual_values (list)
			predicted_values (list)
			weights (list)
		)

		(declare (assoc
			actual_rank_map (call !GetWeightedRankMap (assoc values actual_values weights weights))
			predicted_rank_map (call !GetWeightedRankMap (assoc values predicted_values weights weights))
			normalized_weights
				(if (= 0 (apply "+" weights))
					(normalize (map 1 weights))
					(normalize weights)
				)

			actual_ranks (unzip actual_rank_map actual_values)
			predicted_ranks (unzip predicted_rank_map predicted_values)

			weighted_mean_actual (dot_product normalized_weights actual_ranks)
			weighted_mean_predicted (dot_product normalized_weights predicted_ranks)

			weighted_covariance
				(apply "+" (map
					(lambda
						(*
							(first (current_value))
							(- (get (current_value) 1) weighted_mean_actual)
							(- (last (current_value)) weighted_mean_predicted)
						)
					)
					normalized_weights
					actual_ranks
					predicted_ranks
				))
			weighted_variance_actual
				(apply "+" (map
					(lambda (* (first (current_value)) (pow (- (last (current_value)) weighted_mean_actual) 2)))
					normalized_weights
					actual_ranks
				))
			weighted_variance_predicted
				(apply "+" (map
					(lambda (* (first (current_value)) (pow (- (last (current_value)) weighted_mean_predicted) 2)))
					normalized_weights
					predicted_ranks
				))
		))

		(/ weighted_covariance (sqrt (* weighted_variance_actual weighted_variance_predicted)))
	)



	;weighted confusion matrix:
		; (map
		; 						(lambda
		; 							;don't include predicted nulls
		; 							(if (!= .null (last (current_value)))
		; 								(accum
		; 									"feature_confusion_matrix"
		; 									[(first (current_value 1)) (last (current_value 1))]
		; 									(get (current_value) 1)
		; 								)
		; 							)
		; 						)
		; 						(map (lambda (get (current_value) actual_offset)) (current_value))
		; 						weights
		; 						(map (lambda (get (current_value) predicted_offset)) (current_value))
		; 					)


}